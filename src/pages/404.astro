---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found · Alexander Sivitilli"
  description="That page does not exist. Head back to the projects, publications or home page."
>
  <header class="page-hero shell">
    <p class="eyebrow">404</p>
    <h1>That page is not here.</h1>
    <p>
      The link may be out of date, or the page may have moved. The projects and
      publications below are the two places most things live.
    </p>

    <div class="button-row">
      <a class="button primary" href="/">Back to home</a>
      <a class="button" href="/projects/">Projects</a>
      <a class="button" href="/publications/">Publications</a>
    </div>
  </header>
</BaseLayout>
