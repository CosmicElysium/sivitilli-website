---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectImage from "../../components/ProjectImage.astro";
import { projects } from "../../data/content";

const project = projects.find((item) => item.slug === "spacedome");

if (!project) {
  throw new Error('Project "spacedome" was not found in src/data/content.ts.');
}

const statusLabel = project.status === "past" ? "Completed" : "Current";

// External references linked inline from the page copy.
const external = { target: "_blank", rel: "noopener noreferrer" };
const refs = {
  esa: "https://www.esa.int/",
  call: "https://business.esa.int/funding/call-for-proposals-competitive/space-for-metaverse",
  copernicus: "https://www.copernicus.eu/en",
  sentinel2: "https://sentiwiki.copernicus.eu/web/s2-mission",
  cog: "https://cogeo.org/",
  euHydro: "https://land.copernicus.eu/en/products/eu-hydro",
  blueMarble:
    "https://science.nasa.gov/earth/earth-observatory/collections/blue-marble/",
  aop: "https://armagh.space/",
  tourismNI: "https://www.tourismni.com/",
  ukSpaceAgency:
    "https://www.gov.uk/government/organisations/uk-space-agency",
  liminal: "https://liminalscientific.com/",
};

// Photographs and renders only: project diagrams are not published.
// Renders containing Sentinel-2 imagery must keep the Copernicus credit.
const images = {
  hero: {
    src: "/images/projects/spacedome/live-show.webp",
    width: "901",
    height: "677",
    alt: "A presenter wearing a VR headset stands before the audience seating in the Armagh planetarium dome, with live-fetched satellite imagery of Tokyo Bay projected on the dome above",
    caption:
      "The live show in the Armagh dome. The presenter has marked an area of Tokyo Bay on the globe, and the Sentinel-2 scene fetched on request is projected through the venue's own dome system. Photograph: Armagh Observatory & Planetarium. Contains modified Copernicus Sentinel data 2026.",
  },
  bloom: {
    src: "/images/projects/spacedome/lough-neagh-bloom.webp",
    width: "1400",
    height: "1447",
    alt: "Sentinel-2 satellite image of Lough Neagh, with swirls of green algal bloom across the dark water of the lough",
    caption: "Lough Neagh during the late-summer algal bloom, as the audience sees it.",
  },
  bloomFisheye: {
    src: "/images/projects/spacedome/lough-neagh-bloom-fisheye.webp",
    width: "1400",
    height: "1400",
    alt: "The same Lough Neagh scene rendered as a circular full-dome fisheye frame, with the curve of the globe and a blue sky above",
    caption:
      "The same frame as the full-dome fisheye streamed to the projection system.",
  },
  rivers: {
    src: "/images/projects/spacedome/lough-neagh-rivers.webp",
    width: "1920",
    height: "1080",
    alt: "The EU-Hydro river network drawn in blue over satellite imagery of Lough Neagh, showing the rivers that feed the lough and the Lower Bann flowing out to the north",
    caption:
      "Asked how the rivers feed the lough, the guide draws the EU-Hydro river network over the imagery, with the Lower Bann carrying the outflow north. Rendered by SpaceDome. Contains modified Copernicus Sentinel data 2026; rivers from EU-Hydro, Copernicus Land Monitoring Service.",
  },
};

const sequenceFrames = [
  {
    src: "/images/projects/spacedome/sequence-fetching.webp",
    alt: "Split frame. Left, the dome fisheye with a selection box over Lough Neagh. Right, the presenter's headset view with the message: Fetching the most recent clear satellite pass for your selection.",
    caption:
      "The presenter marks Lough Neagh and asks for the latest clear satellite pass.",
  },
  {
    src: "/images/projects/spacedome/sequence-cloudy-pass.webp",
    alt: "Split frame showing the 18 October 2026 Sentinel-2 pass over Lough Neagh, largely covered by cloud, on both the dome fisheye and the presenter's headset view.",
    caption: "The most recent pass, from 18 October 2026, arrives under cloud.",
  },
  {
    src: "/images/projects/spacedome/sequence-august-preview.webp",
    alt: "Split frame showing a clear preview of a mid-August Sentinel-2 scene of Lough Neagh placed on the globe, on both the dome fisheye and the presenter's headset view.",
    caption:
      "Asked for mid-August instead, the guide fetches a clear scene and shows a preview first.",
  },
  {
    src: "/images/projects/spacedome/sequence-scene-ready.webp",
    alt: "Split frame showing the full-resolution Lough Neagh scene on the globe, with the message in the headset view: The scene from 2026-08-24 is ready.",
    caption:
      "The full-resolution scene from 24 August 2026 replaces the preview.",
  },
];
---

<BaseLayout
  title="SpaceDome — From Space to Dome: Immersive Tourism through Earth Observation · Alexander Sivitilli"
  description="Technical Lead on SpaceDome, an ESA Space for Metaverse project turning Copernicus Earth-observation data into live, voice-driven planetarium dome shows led by a VR presenter with an AI guide."
>
  <article class="project-page">
    <nav class="project-breadcrumb shell" aria-label="Breadcrumb">
      <a href="/projects/">Projects</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">SpaceDome</span>
    </nav>

    <header
      class:list={[
        "project-detail-hero",
        "shell",
        !images.hero.src && "project-detail-hero--without-media",
      ]}
    >
      <div class="project-detail-intro">
        <p class="eyebrow">
          Earth observation and AI-assisted immersive data demonstration ·
          Active project
        </p>
        <h1>SpaceDome: From Space to Dome</h1>
        <p class="project-subtitle">
          Immersive Data-driven Tourism through Earth Observation
        </p>
        <p class="project-deck">
          A presenter-led planetarium show built on real Copernicus
          Earth-observation data. The presenter, in a VR headset, asks an AI
          guide by voice to fly the audience anywhere on Earth and fetch fresh
          Sentinel-2 satellite imagery on the spot.
        </p>

        <div class="button-row">
          {
            project.links.map((link) => (
              <a
                class:list={[
                  "button",
                  link.type === "Funding call" && "primary",
                ]}
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>

      {
        images.hero.src && (
          <figure class="project-hero-media">
            <ProjectImage
              src={images.hero.src}
              alt={images.hero.alt}
              width={images.hero.width}
              height={images.hero.height}
              loading="eager"
              fetchpriority="high"
            />
            <figcaption>{images.hero.caption}</figcaption>
          </figure>
        )
      }

      <dl class="project-facts">
        <div>
          <dt>Status</dt>
          <dd>{statusLabel}</dd>
        </div>
        <div>
          <dt>Dates</dt>
          <dd>{project.period}</dd>
        </div>
        <div>
          <dt>Institution</dt>
          <dd>{project.organisation}</dd>
        </div>
        <div>
          <dt>Funding</dt>
          <dd>ESA Space for Metaverse · Kick-Start</dd>
        </div>
        <div>
          <dt>Role</dt>
          <dd>{project.role}</dd>
        </div>
      </dl>

      <ul class="project-tags" aria-label="Project topics">
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    <div class="project-body shell">
      <section class="project-detail-section" aria-labelledby="overview-title">
        <div class="section-label">
          <p class="eyebrow">Overview</p>
          <h2 id="overview-title">
            A dome show that renews itself from satellite data.
          </h2>
        </div>

        <div class="project-prose">
          <p class="lead">
            Planetarium and visitor-attraction shows are often pre-baked experiences: expensive to commission, slow to update and disconnected from
            recent datasets gathered by scientists.
            SpaceDome addresses this by creating a live show built from that data.
          </p>

          <p>
            A presenter wearing a VR headset leads the dome audience across a
            globe of recent <a href={refs.copernicus} {...external}>Copernicus</a> satellite
            data. Drawing on their own expertise, they ask an AI guide by voice
            to fly to a place, fetch <a href={refs.sentinel2} {...external}>Sentinel-2</a> satellite
            imagery for a chosen date and supply short factual answers. The
            audience puts its questions through the presenter, so the AI remains
            a tool the presenter conducts rather than an autonomous narrator.
          </p>

          <p>
            The project is a six-month feasibility study funded by the <a href={refs.esa} {...external}>European Space Agency</a> through
            its <a href={refs.call} {...external}>Space for Metaverse</a> Kick-Start
            call and led by <a href={refs.aop} {...external}>Armagh Observatory &amp; Planetarium</a>.
            Regional tourism in Northern Ireland is the first application,
            alongside education and climate communication. Showing a new place
            or date needs a data fetch and some preparation, not a new
            production.
          </p>
        </div>
      </section>

      <section class="project-detail-section" aria-labelledby="role-title">
        <div class="section-label">
          <p class="eyebrow">My role</p>
          <h2 id="role-title">From system design to the live show.</h2>
        </div>

        <div class="project-prose">
          <p>
            As Technical Lead, I led the technical-feasibility work package that
            took SpaceDome from concept to a working proof of concept, and
            co-authored the project's final service-requirements, architecture,
            proof-of-concept and business-plan deliverables.
          </p>

          <ul class="scope-list">
            <li>
              Set the system architecture: a single show machine running the
              real-time application alongside separate data and AI services, so
              that a slow download or a slow answer never stalls the picture.
            </li>
            <li>
              Built the Unity application from a loose fork of <a href="/projects/idavie/">iDaVIE</a>,
              including the data-docking globe, the
              presenter's VR interaction and the full-dome fisheye output
              streamed into the venue's existing projection system.
            </li>
            <li>
              Built the on-demand Earth-observation pipeline that finds and
              fetches Sentinel-2 satellite imagery, displays it in stages from a
              quick preview to the full-resolution scene, and overlays the <a href={refs.euHydro} {...external}>EU-Hydro</a> river
              network.
            </li>
            <li>
              Co-developed the voice and AI-guide layer with the team, from
              speech recognition on the show machine to the small, validated set
              of actions the guide is allowed to take.
            </li>
            <li>
              Co-presented the live demonstration in the Armagh digital dome, with my
              colleague Andrew Marshall-Lee leading from the headset.
            </li>
          </ul>
        </div>
      </section>

      <section class="project-detail-section" aria-labelledby="system-title">
        <div class="section-label">
          <p class="eyebrow">How it works</p>
          <h2 id="system-title">Three pieces behind one live show.</h2>
        </div>

        <div>
          <div class="system-grid">
            <article class="system-card">
              <p class="system-number" aria-hidden="true">01</p>
              <h3>Copernicus data on demand</h3>
              <p>
                Sentinel-2 satellite imagery is fetched when the presenter asks
                for it, for any place the satellites have observed and for dates
                described in everyday terms such as "mid-August" or "a year
                ago". Scenes are read straight from public <a href={refs.cog} {...external}>Cloud Optimized GeoTIFFs</a>,
                so only the selected area is downloaded, and each file's
                built-in low-resolution overviews give a preview within seconds
                that sharpens to the full 10 m scene in under a minute.
              </p>
            </article>

            <article class="system-card">
              <p class="system-number" aria-hidden="true">02</p>
              <h3>Voice, with the presenter in charge</h3>
              <p>
                The presenter speaks to the AI guide through push-to-talk.
                Speech is recognised on the show machine, and the guide replies
                in two or three sentences on a panel on the presenter's hand,
                taking at most one action per answer.
              </p>
            </article>

            <article class="system-card">
              <p class="system-number" aria-hidden="true">03</p>
              <h3>One application, headset and dome</h3>
              <p>
                A single Unity application renders the presenter's headset view
                and a full-dome fisheye of the same scene at the same time. The
                fisheye is streamed as standard video into the dome system a
                venue already has, so no new playback software is needed.
              </p>
            </article>
          </div>

          <div class="project-gallery project-gallery--pair">
            {
              [images.bloom, images.bloomFisheye].map((image) => (
                <figure>
                  <ProjectImage
                    src={image.src}
                    alt={image.alt}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                  />
                  <figcaption>{image.caption}</figcaption>
                </figure>
              ))
            }
          </div>

          <p class="media-credit">
            Rendered by SpaceDome. Contains modified Copernicus Sentinel data
            2026. Base globe from <a href={refs.blueMarble} {...external}>NASA Blue Marble</a>.
          </p>
        </div>
      </section>

      <section
        class="project-detail-section"
        aria-labelledby="principles-title"
      >
        <div class="section-label">
          <p class="eyebrow">Design principles</p>
          <h2 id="principles-title">Rules that keep a live show on track.</h2>
        </div>

        <div class="system-grid">
          <article class="system-card system-card--compact">
            <p class="system-number" aria-hidden="true">01</p>
            <h3>The AI never invents a place or a date</h3>
            <p>
              Every action the guide can take draws its arguments from closed
              lists, and everyday dates are resolved by software rather than by
              the model. A misheard or invented value cannot send the show to
              the wrong place or time.
            </p>
          </article>

          <article class="system-card system-card--compact">
            <p class="system-number" aria-hidden="true">02</p>
            <h3>Stopping never depends on the model</h3>
            <p>
              Fetching a scene takes time, so a plain "stop" or "cancel"
              bypasses the language model entirely and halts the request
              straight away.
            </p>
          </article>

          <article class="system-card system-card--compact">
            <p class="system-number" aria-hidden="true">03</p>
            <h3>The presenter stays the voice of the show</h3>
            <p>
              The guide's answers appear on the presenter's hand panel, and the
              presenter relays them in their own words. The AI supports human
              expertise rather than addressing the public directly.
            </p>
          </article>
        </div>
      </section>

      <section class="project-detail-section" aria-labelledby="demo-title">
        <div class="section-label">
          <p class="eyebrow">Live show tests</p>
          <h2 id="demo-title">Live, voice-driven shows in the Armagh dome.</h2>
        </div>

        <div>
          <div class="project-prose">
            <p class="lead">
              We tested SpaceDome live in the Armagh Observatory & Planetarium
              dome, in front of audiences of AOP staff and students. One laptop
              on the lectern drove both the presenter's headset and the dome.
            </p>

            <ol class="process-list">
              <li>
                <div>
                  <h3>Fly to Lough Neagh</h3>
                  <p>
                    When running live shows, the presenter would ask the system
                    to fly to Lough Neagh, the largest lake in the British Isles,
                    and fetch current Sentinel-2 satellite imagery showing its
                    algal bloom.
                  </p>
                </div>
              </li>
              <li>
                <div>
                  <h3>Compare across time</h3>
                  <p>
                    The system would then fetch the same area for mid-August, and
                    for the same period a year earlier, so the audience could
                    compare the bloom across seasons and years.
                  </p>
                </div>
              </li>
              <li>
                <div>
                  <h3>Answer audience questions</h3>
                  <p>
                    When audience members asked questions, the presenter would
                    put them to the guide. Asked how the rivers feed the lough,
                    for example, the guide answered and drew the river network
                    over the imagery.
                  </p>
                </div>
              </li>
              <li>
                <div>
                  <h3>Go somewhere unscripted</h3>
                  <p>
                    The presenter could also take the audience off-script, for
                    example by marking an area of Tokyo Bay by hand on the globe
                    and having the system fetch imagery for it.
                  </p>
                </div>
              </li>
            </ol>

            <p>
              Imagery arrived as a preview within seconds, a coarse version at
              about five seconds and the full 10 m scene in under a minute.
            </p>

            <p>
              Those times are for a scene's first fetch. Every scene is then
              cached on the show machine, so a presenter can design a show in
              advance by fetching its places and dates, and later live shows
              load them straight from the cache without a download. Only
              off-script requests then need fresh imagery.
            </p>
          </div>

          <figure class="project-wide-media">
            <ProjectImage
              src={images.rivers.src}
              alt={images.rivers.alt}
              width={images.rivers.width}
              height={images.rivers.height}
              loading="lazy"
            />
            <figcaption>{images.rivers.caption}</figcaption>
          </figure>

          <aside class="evidence-note" aria-labelledby="dome-testing-title">
            <p class="eyebrow">Testing in the dome</p>
            <h3 id="dome-testing-title">
              The dome found what the desk could not.
            </h3>
            <p>
              Every desk view had looked straight down at the globe, the one
              angle that hides height errors. Two rounds of testing on the
              Armagh dome showed river overlays floating about 38 km above the
              ground and a dome image that followed the presenter's head. Both
              were fixed before any audience saw the show, by lowering the
              overlays to the surface and rendering the dome from a fixed
              audience viewpoint.
            </p>
          </aside>
        </div>
      </section>

      <section class="project-detail-section" aria-labelledby="sequence-title">
        <div class="section-label">
          <p class="eyebrow">Show sequence</p>
          <h2 id="sequence-title">A request, frame by frame.</h2>
        </div>

        <div>
          <div class="project-prose">
            <p>
              These frames come from a recorded run of the show sequence. Each
              pairs the dome fisheye, on the left, with the presenter's headset
              view, on the right.
            </p>
          </div>

          <ol class="sequence-list">
            {
              sequenceFrames.map((frame) => (
                <li>
                  <figure>
                    <ProjectImage
                      src={frame.src}
                      alt={frame.alt}
                      width="2400"
                      height="829"
                      loading="lazy"
                    />
                    <figcaption>{frame.caption}</figcaption>
                  </figure>
                </li>
              ))
            }
          </ol>

          <p class="media-credit">
            Rendered by SpaceDome. Contains modified Copernicus Sentinel data
            2026. Base globe from <a href={refs.blueMarble} {...external}>NASA Blue Marble</a>.
          </p>
        </div>
      </section>

      <section class="project-detail-section" aria-labelledby="outcomes-title">
        <div class="section-label">
          <p class="eyebrow">Outcomes</p>
          <h2 id="outcomes-title">What the Kick-Start delivered.</h2>
        </div>

        <div class="outcomes-grid">
          <article>
            <h3>Live in a working dome</h3>
            <p>
              The show ran through the existing projection system of a working
              planetarium, with the dome image streamed as standard video rather
              than requiring new playback software.
            </p>
          </article>

          <article>
            <h3>Technology readiness level 4</h3>
            <p>
              AI orchestration, voice recognition and the Earth-observation
              pipeline now stand at TRL 4 and together form a TRL-4 proof of
              concept, with the link between headset and dome also raised to
              TRL 4.
            </p>
          </article>

          <article>
            <h3>Beyond English</h3>
            <p>
              Speakers from Newry and Dublin were transcribed reliably, and the
              guide worked in French and Irish by changing only the
              speech-recognition language and one instruction, with no code
              changes.
            </p>
          </article>

          <article>
            <h3>Anywhere on request</h3>
            <p>
              Because imagery is fetched live, the show is not limited to
              prepared content. Any place the Sentinel-2 satellites have
              observed can be shown, as the unscripted visit to Tokyo Bay
              demonstrated.
            </p>
          </article>
        </div>
      </section>

      <section class="project-detail-section" aria-labelledby="limits-title">
        <div class="section-label">
          <p class="eyebrow">Limitations and next steps</p>
          <h2 id="limits-title">A proof of concept, not yet a service.</h2>
        </div>

        <div class="project-prose">
          <p>
            SpaceDome has so far run at one venue, on one dome system, presented
            by the people who built it. Its frame rate holds up at rest but dips
            while navigating, and end-to-end performance has not yet been fully
            measured in the dome. The data is limited to Sentinel-2 satellite
            imagery and river networks, and the guide answers in text rather
            than speech.
          </p>

          <p>
            The next phase would take it towards a pilot: venue staff presenting
            after a short training, more dome systems including mobile and
            inflatable domes, a local language model so that a show can run
            offline, spoken answers, elevation, radar and night-light layers,
            and support for standalone headsets.
          </p>
        </div>
      </section>

      <section
        class="project-detail-section"
        aria-labelledby="collaboration-title"
      >
        <div class="section-label">
          <p class="eyebrow">Collaboration</p>
          <h2 id="collaboration-title">
            A planetarium team with an Earth-observation specialist.
          </h2>
        </div>

        <div class="project-prose">
          <p>
            SpaceDome is led by Armagh Observatory &amp; Planetarium, with Prof
            Michael Burton as Project Director and Prof Marc Sarzi as Scientific
            and Sector Lead. Andrew Marshall-Lee and I developed and presented
            the system together. Dr Cormac Purcell of <a href={refs.liminal} {...external}>Liminal Scientific</a> advises
            on Earth-observation data and AI.
          </p>

          <p>
            <a href={refs.tourismNI} {...external}>Tourism Northern Ireland</a> is
            the project's lead customer partner. The work is funded by the
            European Space Agency, with the <a href={refs.ukSpaceAgency} {...external}>UK Space Agency</a> as
            the national delegation, and builds on open data from the EU's <a href={refs.copernicus} {...external}>Copernicus</a> programme.
          </p>
        </div>
      </section>

      <section class="project-resources" aria-labelledby="resources-title">
        <div>
          <p class="eyebrow">Resources</p>
          <h2 id="resources-title">The funding call and the engine behind it.</h2>
        </div>

        <div class="resource-list">
          {
            project.links.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer">
                <span class="resource-type">{link.type}</span>
                <strong>{link.label}</strong>
                {link.description && <span>{link.description}</span>}
              </a>
            ))
          }
        </div>
      </section>

      <nav class="project-footer-nav" aria-label="Project navigation">
        <a href="/projects/">
          <span aria-hidden="true">←</span>
          Back to all projects
        </a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .project-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-top: clamp(1.5rem, 4vw, 3rem);
    color: var(--text-muted);
    font-size: 0.88rem;
  }

  .project-breadcrumb a {
    text-underline-offset: 0.22em;
  }

  .project-detail-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-block: clamp(3rem, 8vw, 7.5rem);
  }

  .project-detail-hero--without-media .project-detail-intro {
    grid-column: 1 / -1;
    max-width: 72rem;
  }

  .project-detail-hero--without-media .project-facts,
  .project-detail-hero--without-media .project-tags {
    grid-column: 1 / -1;
  }

  .project-detail-intro h1 {
    max-width: 14ch;
    margin-top: 0.8rem;
    font-size: clamp(2.9rem, 7.2vw, 6.4rem);
    letter-spacing: -0.06em;
    line-height: 0.94;
  }

  .project-subtitle {
    max-width: 30ch;
    margin: 1.1rem 0 0;
    color: var(--text);
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .project-deck {
    max-width: 48rem;
    margin: 1.6rem 0 0;
    color: var(--text-soft);
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.55;
  }

  .project-detail-intro .button-row {
    margin-top: 2rem;
  }

  .project-hero-media,
  .project-wide-media {
